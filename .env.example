# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# --- Serveur HTTP ---
# 0.0.0.0 : toutes les interfaces (obligatoire en conteneur)
HOST=0.0.0.0
PORT=3000
# URL publique des liens courts (vide : déduite de la requête)
PUBLIC_URL=

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=raccourcisseur
# Laisser vide pour un MongoDB local sans authentification
MONGO_USER=
# Mot de passe en clair (développement uniquement)...
MONGO_PASSWORD=
# ... ou chemin d'un fichier qui le contient (prioritaire sur MONGO_PASSWORD)
MONGO_PASSWORD_FILE=

# Connexion : nombre de tentatives et délai entre deux tentatives (ms)
MONGO_RETRIES=10
MONGO_RETRY_DELAY_MS=3000
